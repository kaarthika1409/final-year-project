# Database connection string (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./nutrition_app.db
# For PostgreSQL deployment, use:
# DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/nutrition_db

# JWT Security Credentials
JWT_SECRET_KEY=super_secret_jwt_key_change_in_production_environment_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Port & Configuration
PORT=8000
HOST=0.0.0.0
